<wxs src="../../common.wxs" module="morejs" />
<view class="top_contain">
      <view class="top_img">
            <image lazy-load src="/images/测验.png"></image>
      </view>
      
      
      <view class="price_box">
            <view class="now_price">￥30.00元</view>
            
      </view>
</view>
<view class="blank"></view>
<view class="center_contain">
  <view class="c_title title_on">发布详情</view>    
</view>
<!--发布信息-->

      <view class="user_box">
            <image lazy-load src="/images/测验.png"></image>
            <view class="des_box">
                  <view class="user_name">狐疑欧尼</view>
                  
            </view>
            <view class="sex">
                  <image lazy-load src="{{userinfo.info.gender==0?'/images/none.png':(userinfo.info.gender==1?'/images/girl.png':'/images/boy.png')}}"></image>
            </view>
      </view>
      <view class="time_box">
            <!-- <view class="kind">{{collegeName.name}}类书</view> -->
            <view class="time">发布于2025年3月5日</view>
      </view>
  

<view style="height: 96rpx;"></view>
<!--底部导航-->
<view class="tabbar">
      <view class="t_card">
            <image src="/images/home.png"></image>
            <text>首页</text>
            <button class="t_button" bindtap="home"></button>
      </view>
      >
      <view class="t_card">
            <image src="/images/share.png"></image>
            <text>分享</text>
            <button class="t_button" open-type="share"></button>
      </view>
     
      <view class="buy_box">
            <view class="buy shadow" bindtap="buy">{{publishinfo.status==0?'立即购买':'刚刚被抢光了'}}</view>
      </view>
</view>

<!--悬浮客服功能-->
<view class="contact_box" bindtap="go" data-go="/pages/kefu/kefu" animation="{{animationKefuData}}">
     <image src="/images/ww.jpg" ></image>
     <view >反馈</view>
</view>