<view class="top_steps">
      <van-steps steps="{{ steps }}" active="{{ active }}" active-color="#000000" />
</view>
<view style="height:66.8px"></view>

<!-- 步骤一 -->
<van-transition show="{{ show_a }}" name="fade-right" custom-class="block" duration="{{entime}}">
  <!-- 添加发布类型选择 -->
  <view class="a_contain">
    <radio-group bindchange="chooseType">
      <label class="b_radio" wx:key="id">
        <radio value="product" /> 商品
      </label>
      <label class="b_radio" wx:key="id">
        <radio value="demand" /> 需求
      </label>
    </radio-group>

    <!-- 添加发布类别选择 -->
    <picker mode="selector" range="{{categories}}" range-key="name" value="{{selectedCategoryIndex}}" bindchange="chooseCategory">
      <view class="b_picker">
        当前选择：{{selectedCategory}}
      </view>
    </picker>
    <view class="a_confirm" bindtap="confirm">确认</view>
  </view>
</van-transition>
<!-- 步骤二 -->
<van-transition show="{{ show_b }}" name="fade-right" custom-class="block" duration="{{entime}}">
  <view class="b_contain">
    <!-- 标题输入 -->
    <view class="b_bar">
      <input placeholder="请输入标题（不超过20字）" bindinput="bindTitleInput" value="{{title}}" maxlength="20"/>
    </view>
    
    <!-- 详情信息输入 -->
    <view class="b_bar">
      <textarea placeholder="请输入详情信息（可选填，限制200字）" bindinput="bindDetailsInput" value="{{details}}" maxlength="200"/>
    </view>

    <!-- 联系方式输入 -->
    <view class="b_bar">
      <input placeholder="请输入联系方式（必填，不超过20字）" bindinput="bindContactInput" value="{{contactInfo}}" maxlength="20"/>
    </view>
<!-- 上传图框 -->
    <view class="image-container">
  <block wx:for="{{images}}" wx:key="index">
    <view class="image-item" style="position:relative;">
      <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" class="uploaded-image"/>
      <image class="delete-btn" src="/images/on.png" data-index="{{index}}" bindtap="deleteImage"></image>
    </view>
  </block>
  <view class="upload-btn" wx:if="{{images.length < maxImages}}" bindtap="chooseImage">
    <image src="/images/off.png" class="add-icon" />
  </view>
</view>
<!-- 价格输入 -->
<!-- 价格输入 -->
<view class="b_bar" bindtap="showPriceInput">
  <view class="b_name">价格(元)</view>
  <view class="price-display">{{price}}</view> <!-- 显示当前价格 -->
</view>

<!-- 弹出的数字输入框 -->
<van-popup show="{{showPopup}}" position="bottom" custom-style="height: 30%;" bindappear="onPopupAppear">
  <view style="padding: 20rpx;">
    <input 
      id="priceInput"
      type="number" 
      value="{{price}}" 
      placeholder="请输入价格" 
      bindinput="onPriceInput" 
      bindblur="hidePriceInput"
      style="width: 100%; font-size: 48rpx; text-align: center;"
    />
  </view>
</van-popup>
    <!-- 马上发布 -->
    <view class="b_publish" bindtap="publish">马上发布</view>
  </view>
</van-transition>
<!--步骤三-->
<van-transition show="{{ show_c }}" name="fade-right" custom-class="block" duration="{{entime}}">
      <view class="c_contain" style="height:{{systeminfo.windowHeight-66.8}}px">
            <image class="c_success" src="/images/success.png"></image>
            <view class="c_title">恭喜您 发布成功</view>
            <view class="c_des">订单的实时状态将通过短信和邮箱通知您</view>
            <view class="c_see" bindtap="detail" >查看详情</view>
            <view class="c_again shadow" bindtap="initial">再来一本</view>
      </view>
</van-transition>