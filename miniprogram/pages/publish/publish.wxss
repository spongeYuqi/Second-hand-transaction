/* 图片容器 */
/* 图片容器 */
.image-container {
  display: flex;
  flex-wrap: wrap;
}

/* 每个图片项或上传按钮 */
.image-item, .upload-btn {
  position: relative;
  width: calc(25% - 8rpx); /* 根据需要调整间距 */
  padding-top: calc(25% - 8rpx); /* 使用padding-top创建固定宽高比 */
  margin: 4rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  display: flex; /* 使用flex布局来帮助子元素居中 */
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
}

/* 已上传图片样式 */
.uploaded-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover; /* 确保图片覆盖整个区域而不变形 */
}

/* 删除按钮样式 */
.delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  z-index: 10;
}

/* 上传按钮内的加号图标样式 */
.add-icon {
  width: 40rpx; /* 使用rpx单位以适应不同屏幕大小 */
  height: 40rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.price-display {
  font-size: 40rpx;
  color: #333;
  margin-left: auto; /* 让价格显示靠右 */
}
/* 防止页面上移 */
page, .container {
  height: 100%;
  overflow: hidden;
}
/* 设置整体容器的高度和溢出属性 */
page, .container {
  height: 100%;
  overflow: hidden;
}

/* 设置价格显示区域的基本样式 */
.b_bar {
  display: flex;
  align-items: center;
  padding: 10rpx;
}

/* 设置“价格(元)”的样式 */
.b_name {
  font-size: 36rpx; /* 根据实际需要调整字体大小 */
  color: #000; /* 黑色或其他所需的颜色 */
}

/* 设置价格值的样式 */
.price-value {
  font-size: 36rpx; /* 与.b_name的字体大小一致 */
  color: #000; /* 与.b_name的颜色一致 */
}

/* 设置价格占位符（即“请输入”）的样式 */
.price-placeholder {
  font-size: 36rpx; /* 与.b_name的字体大小一致 */
  color: #ccc; /* 较浅的灰色 */
}

