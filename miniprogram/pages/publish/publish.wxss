/*步骤二*/

/* 确保.b_contain使用column方向 */
.b_contain {
  width: 100%;
  padding: 32rpx;
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
}

/* 每个.b_bar有适当的间距 */
.b_bar {
  height: auto; /* 自动高度适应内容 */
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: flex-start; /* 顶部对齐 */
  margin-bottom: 20rpx; /* 增加底部间距 */
}

/* 统一处理所有input和textarea的基本样式 */
.b_bar input, .b_bar textarea {
  width: 100%;
  font-size: 28rpx;
  padding: 20rpx; /* 统一增加内边距 */
  box-sizing: border-box;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  border: 1px solid #ddd;
  height: 80rpx; /* 默认高度 */
}

/* 特别为标题输入框设置样式 */
.b_bar input[placeholder="请输入标题（不超过20字）"] {
  font-weight: bold; /* 强调标题 */
  /* 其他属性已经在通用样式中定义，这里无需重复 */
}

/* 详情信息文本域样式 */
.b_bar textarea[placeholder="请输入详情信息（可选填，限制200字）"] {
  height: 300rpx; /* 覆盖默认高度以提供更大的输入区域 */
  resize: none; /* 防止用户调整大小 */
  /* 其他属性已经在通用样式中定义，这里无需重复 */
}


.b_publish {
