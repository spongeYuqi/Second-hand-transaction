.top_box {
      width: 100%;
      background: #fbbd08;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20rpx 30rpx;
      box-sizing: border-box;
}

.top_list {
      width: 50rpx;
      height: 50rpx;
}

.search_box {
      width: 620rpx;
      height: 66rpx;
      border-radius: 33rpx;
      background: #fff;
      display: flex;
      align-items: center;
}

.search_ico {
      padding-left: 30rpx;
      width: 32rpx;
      height: 32rpx;
}

.search_text {
      padding-left: 10rpx;
      font-size: 28rpx;
      letter-spacing: 2rpx;
      color: rgb(167, 167, 167);
}

.banner {
      width: 100%;
      display: flex;
      box-sizing: border-box;
      height: 184rpx;
}

.banner_image {
      width: 100%;
      padding: 16rpx 16rpx 12rpx 16rpx;
      display: flex;
      box-sizing: border-box;
      height: 160rpx;
}

::-webkit-scrollbar {
      width: 0;
      height: 0;
      color: transparent;
}

.space {
      width: 100%;
      height: 20rpx;
      background: #eee;
}

.kind_contain {
      width: 100%;
      height: 90rpx;
      display: flex;
      border-bottom: 1rpx solid #eee;
      background: #fff;
      align-items: center;
      position: relative;
}

.nav {
      width: calc(100% - 180rpx);
      height: 100%;
      white-space: nowrap;
      display: flex;
      box-sizing: border-box;
}

.nav-item {
      width: 100rpx;
      height: 100%;
      display: inline-block;
      font-size: 32rpx;
}

.nav-text {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      letter-spacing: 4rpx;
      box-sizing: border-box;
}

.tab-on {
      color: #fbbd08;
      font-size: 32rpx !important;
      font-weight: 600;
      border-bottom: 4rpx solid #fbbd08 !important;
}

.kind_img {
      width: 60rpx;
      height: 60rpx;
      display: flex;
      justify-content: center;
      align-items: center;
}

.kind_img image {
      width: 32rpx;
      height: 32rpx;
}

.kindlist_box {
      position: absolute;
      width: 100%;
      top: 90rpx;
      left: 0rpx;
      border-bottom: 1rpx solid #eee;
}

.kindlist_card {
      padding: 20rpx 20rpx 0 20rpx;
      width: 100%;
      display: flex;
      box-sizing: border-box;
      background: #fff;
}

.list_grid {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
}

.list_one {
      width: 25%;
      padding: 0 10rpx 20rpx 10rpx;
      display: flex;
      box-sizing: border-box;
}

.list_one view {
      width: 100%;
      height: 60rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1rpx solid #eee;
      border-radius: 10rpx;
      font-size: 28rpx;
      letter-spacing: 2rpx;
}

.list-on {
      background: #fbbd08;
      color: #fff;
      border: none !important;
}

.card_grid {
      width: 100%;
      display: flex;
      box-sizing: border-box;
      padding: 20rpx 0rpx;
      flex-wrap: wrap;
}

.card_poster {
      width: 300rpx;
      height: 300rpx;
      object-fit: cover;
      aspect-ratio: 1/1;
      overflow: hidden;
      border-radius: 15rpx;
}
.card_one {
      margin-top: 20rpx;
      width: 50%;
      padding: 20rpx;
      display: flex;
      box-sizing: border-box;
      flex-direction: column;
      align-items: center;
}

/* 保证.card_between可以正确地对其内部元素进行布局 */
.card_between {
      margin-top: 5rpx;
      width: 100%;
      display: flex;
      justify-content: flex-start; /* 确保所有子元素从左侧开始排列 */
      align-items: center; /* 垂直居中对齐子元素 */
  }
  
  /* 对于包含价格和购买图标的.card_between，我们希望购买图标位于最右侧 */
  .card_between:last-child { /* 假设这是最后一个.card_between，包含价格和购买图标 */
      justify-content: space-between; /* 或者使用space-between让购买图标尽可能靠右 */
  }
  
  .list_price, .card_buy {
      display: flex;
      align-items: center; /* 如果有垂直对齐的需求 */
  }
  
  /* 确保.card_buy尽可能靠右 */
  .card_buy {
      margin-left: auto; /* 这会把.card_buy推到最右边 */
      padding-right: 10rpx;
      width: 40rpx;
      height: 40rpx;
  }

  /* 确保.card_title和.card_author有合适的样式 */
  .card_title, .card_author {
      font-size: 26rpx;
      color: #919191;
      /* 添加或确认以下两行 */
      margin: 0 10rpx; /* 给.card_author留出一些空间 */
      white-space: nowrap; /* 防止文本换行 */
  }
.list_box {
      width: 100%;
      height: 290rpx;
      border-bottom: 1rpx solid #eee;
      padding: 5rpx;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-sizing: border-box;
}

.list_content {
      height: 250rpx;
      width: calc(100% - 230rpx);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0 5rpx;
      box-sizing: border-box;
}
.list_poster {
      width: 250rpx;
      height: 250rpx;
      object-fit: cover;
      aspect-ratio: 1/1;
      overflow: hidden;
      border-radius: 15rpx;
      margin-left: 8rpx;
      margin-right: 20rpx;
}



.list_word {
      display: flex;
      flex-direction: column;
      width: 100%;
      box-sizing: border-box;
}

.list_info {
      display: flex;
      flex-direction: row;
      gap: 20rpx;
      padding-top: 0rpx;
      width: 100%;
      overflow: hidden; /* 确保过长内容不会导致溢出 */
  }
  
  .type-text, .category-text {
      font-size: 26rpx;
      color: #919191;
      flex-shrink: 0; /* 防止文本因为空间不足而缩小 */
      white-space: nowrap; /* 强制文本不换行 */
  }
  
.list_title {
      height:40rpx;
      width: 400rpx;
      font-size: 32rpx;
      letter-spacing: 3rpx;
      line-height: 44rpx;
      margin-top: 2rpx;
      margin-bottom: 50rpx;
}

.list_author {
      padding-top: 10rpx;
      width: 100%;
      font-size: 27rpx;
      letter-spacing: 3rpx;
      line-height: 40rpx;
      color: rgb(129, 129, 129);
}

.list_between {
      margin: 0;
      width: 100%;
      display: flex;
      flex-direction: column;
}

.list_price {
      font-size: 36rpx;
      color: rgb(255, 0, 0);
      display: flex;
      align-items: baseline;
}
.user_info_container {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0;
}

.user_info {
      display: flex;
      align-items: center;
      gap: 1px;
}


.nickname {
      font-size: 28rpx;
      color: #919191;
}
      



.price-symbol {
      font-size: 28rpx;
      margin-right: 4rpx;
}

.tab {
      font-size: 28rpx;
      letter-spacing: 2rpx;
      color: #919191;
      min-width: 150rpx;
      text-align: right;
}

.avatar {
      width: 50rpx;
      height: 50rpx;
      border-radius: 50%;
      margin-right: 16rpx; /* 给头像右边一些空间 */
      border: 0.5px solid #fbbd08;
      object-fit: cover;
      aspect-ratio: 1/1;
      overflow: hidden;
     
  }

.nocontent {
      width: 100%;
      height: calc(100% - 400rpx);
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      box-sizing: border-box;
}

.nocontent image {
      padding-left: 80rpx;
      width: 340rpx;
      height: 272rpx;
}

.blank_text {
      padding-top: 40rpx;
      font-size: 32rpx;
      letter-spacing: 2rpx;
      color: #c6c6c8;
}

.fixed {
      position: fixed;
      left: 0rpx;
      top: 0rpx;
}

.nofixed {
      height: 91rpx;
      width: 100%;
      background: #fff;
}
.list_word, .list_between, .user_info_container {
      margin: 0; /* 移除默认的外边距 */
      padding: 0; /* 移除默认的内边距 */
  }

