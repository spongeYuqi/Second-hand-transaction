<wxs src="../../../common.wxs" module="morejs" />
<view class="contain" wx:if="{{list.length!==0}}">
      <block wx:for="{{list}}" wx:key="_id">
            <view class="card" bindtap="detail" data-id="{{item._id}}">
                  <view class="a">
                        <view class="a1">
                              <image lazy-load src="/images/gzh.png"></image>
                              已发布
                        </view>
                        <view class="time_box">
                              <view class="time">{{item.creatTimeFormatted}}</view>
                        </view>
                  </view>
                  <view class="b">
                        <view class="b1">
                              <view class="b11">
                                    <view class="b111 text-cut">{{item.type}}</view>
                                    <view class="b112 text-cut">{{item.category}}</view>
                              </view>
                              <view class="b12">￥{{item.price}}</view>
                        </view>
                        <image class="b2" lazy-load mode="aspectFill" src="{{item.images && item.images.length > 0 ? item.images[0] : '/images/moren.png'}}" />
                  </view>
                  <!-- 根据isOwner属性决定是否显示删除按钮 -->
                  <view class="c" wx:if="{{item.isOwner}}">
                        <view class="c1 bg-grey" catchtap="del" data-del="{{item}}">删除</view>
                  </view>
            </view>
      </block>
</view>
<!-- 无内容显示 -->
<view class="nocontent" wx:if="{{list.length==0}}">
      <image src="/images/blank.png"></image>
      <view class="blank_text">这里空空如也~</view>
</view>
<block wx:if="{{list.length>10}}">
      <import src="/common.wxml" />
      <template is="loadmore" data="{{nomore}}" />
</block>
<van-transition show="{{ scrollTop>500 }}" custom-class="block" duration="600">
      <view class="totop" bindtap="gotop">
            <image src="/images/top.png"></image>
      </view>
</van-transition>